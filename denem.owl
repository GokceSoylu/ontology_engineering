<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/ontology#"
     xml:base="http://example.org/ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:ex="http://example.org/ontology#"
     xmlns:webprotege="http://webprotege.stanford.edu/">
  
    <!-- Ontoloji Tanımlaması -->
    <owl:Ontology rdf:about="http://example.org/ontology#"/>

    <!-- city -->
    <owl:AnnotationProperty rdf:about="http://example.org/ontology#city">
        <rdfs:label xml:lang="en">City</rdfs:label>
    </owl:AnnotationProperty>
    
    <!-- endDate -->
    <owl:AnnotationProperty rdf:about="http://example.org/ontology#endDate">
        <rdfs:label xml:lang="en">End Date</rdfs:label>
    </owl:AnnotationProperty>

    <!-- eventType -->
    <owl:AnnotationProperty rdf:about="http://example.org/ontology#eventType">
        <rdfs:label xml:lang="en">Event Type</rdfs:label>
    </owl:AnnotationProperty>

    <!-- hasLocation -->
    <owl:ObjectProperty rdf:about="http://example.org/ontology#hasLocation">
        <rdfs:domain rdf:resource="http://example.org/ontology#Event"/>
        <rdfs:range rdf:resource="http://example.org/ontology#Location"/>
        <rdfs:label xml:lang="en">Has Location</rdfs:label>
    </owl:ObjectProperty>

    <!-- hasOrganizer -->
    <owl:ObjectProperty rdf:about="http://example.org/ontology#hasOrganizer">
        <rdfs:domain rdf:resource="http://example.org/ontology#Event"/>
        <rdfs:range rdf:resource="http://example.org/ontology#Organizer"/>
        <rdfs:label xml:lang="en">Has Organizer</rdfs:label>
    </owl:ObjectProperty>

    <!-- hasParticipant -->
    <owl:ObjectProperty rdf:about="http://example.org/ontology#hasParticipant">
        <rdfs:domain rdf:resource="http://example.org/ontology#Event"/>
        <rdfs:range rdf:resource="http://example.org/ontology#Person"/>
        <rdfs:label xml:lang="en">Has Participant</rdfs:label>
    </owl:ObjectProperty>

    <!-- hasTime -->
    <owl:ObjectProperty rdf:about="http://example.org/ontology#hasTime">
        <rdfs:domain rdf:resource="http://example.org/ontology#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">Has Time</rdfs:label>
    </owl:ObjectProperty>

    <!-- startDate -->
    <owl:AnnotationProperty rdf:about="http://example.org/ontology#startDate">
        <rdfs:label xml:lang="en">Start Date</rdfs:label>
    </owl:AnnotationProperty>

    <!-- venue -->
    <owl:AnnotationProperty rdf:about="http://example.org/ontology#venue">
        <rdfs:label xml:lang="en">Venue</rdfs:label>
    </owl:AnnotationProperty>

    <!-- fllows -->
    <owl:ObjectProperty rdf:about="http://example.org/ontology#follows">
        <rdfs:domain rdf:resource="http://example.org/ontology#Person"/>
        <rdfs:range rdf:resource="http://example.org/ontology#Event"/>
        <rdfs:label xml:lang="en">Follows</rdfs:label>
    </owl:ObjectProperty>

    <!-- overlaps -->
    <owl:ObjectProperty rdf:about="http://example.org/ontology#overlaps">
        <rdfs:domain rdf:resource="http://example.org/ontology#Event"/>
        <rdfs:range rdf:resource="http://example.org/ontology#Event"/>
        <rdfs:label xml:lang="en">Overlaps</rdfs:label>
    </owl:ObjectProperty>

    <!-- isSameAs -->
    <owl:ObjectProperty rdf:about="http://example.org/ontology#isSameAs">
        <rdfs:domain rdf:resource="http://example.org/ontology#Event"/>
        <rdfs:range rdf:resource="http://example.org/ontology#Event"/>
        <rdfs:label xml:lang="en">Is Same As</rdfs:label>
    </owl:ObjectProperty>

     <!-- Event Class -->
    <owl:Class rdf:about="http://example.org/ontology#Event">
        <rdfs:label xml:lang="en">Event</rdfs:label>
    </owl:Class>

    <!-- Location Class -->
    <owl:Class rdf:about="http://example.org/ontology#Location">
        <rdfs:label xml:lang="en">Location</rdfs:label>
    </owl:Class>

    <!-- Organizer Class -->
    <owl:Class rdf:about="http://example.org/ontology#Organizer">
        <rdfs:label xml:lang="en">Organizer</rdfs:label>
    </owl:Class>

    <!-- Person Class -->
    <owl:Class rdf:about="http://example.org/ontology#Person">
        <rdfs:label xml:lang="en">Person</rdfs:label>
    </owl:Class>

    <!-- Event Type Class -->
    <owl:Class rdf:about="http://example.org/ontology#EventType">
        <rdfs:label xml:lang="en">Event Type</rdfs:label>
    </owl:Class>

    <!-- City Class -->
    <owl:Class rdf:about="http://example.org/ontology#City">
        <rdfs:label xml:lang="en">City</rdfs:label>
    </owl:Class>

    <!-- Data Property for city -->
    <owl:DatatypeProperty rdf:about="http://example.org/ontology#city">
        <rdfs:domain rdf:resource="http://example.org/ontology#Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">City</rdfs:label>
    </owl:DatatypeProperty>

    <!-- Data Property for startDate -->
    <owl:DatatypeProperty rdf:about="http://example.org/ontology#startDate">
        <rdfs:domain rdf:resource="http://example.org/ontology#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">Start Date</rdfs:label>
    </owl:DatatypeProperty>

    <!-- Data Property for endDate -->
    <owl:DatatypeProperty rdf:about="http://example.org/ontology#endDate">
        <rdfs:domain rdf:resource="http://example.org/ontology#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">End Date</rdfs:label>
    </owl:DatatypeProperty>

    <!-- Data Property for venue -->
    <owl:DatatypeProperty rdf:about="http://example.org/ontology#venue">
        <rdfs:domain rdf:resource="http://example.org/ontology#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">Venue</rdfs:label>
    </owl:DatatypeProperty>

    <!-- Data Property for eventType -->
    <owl:DatatypeProperty rdf:about="http://example.org/ontology#eventType">
        <rdfs:domain rdf:resource="http://example.org/ontology#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">Event Type</rdfs:label>
    </owl:DatatypeProperty>

    <!-- Individual for Event A -->
    <rdf:Description rdf:about="http://example.org/ontology#EventA">
        <rdf:type rdf:resource="http://example.org/ontology#Event"/>
        <ex:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-01-10T10:00:00</ex:startDate>
        <ex:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-01-10T12:00:00</ex:endDate>
        <ex:venue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conference Room A</ex:venue>
        <ex:eventType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Seminar</ex:eventType>
        <ex:hasLocation rdf:resource="http://example.org/ontology#LocationA"/>
    </rdf:Description>

    <!-- Individual for Location A -->
    <rdf:Description rdf:about="http://example.org/ontology#LocationA">
        <rdf:type rdf:resource="http://example.org/ontology#Location"/>
        <ex:city rdf:datatype="http://www.w3.org/2001/XMLSchema#string">New York</ex:city>
    </rdf:Description>


 <!-- AcademicEvent Class -->
    <owl:Class rdf:about="http://example.org/ontology#AcademicEvent">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology#Event"/>
        <rdfs:label xml:lang="en">AcademicEvent</rdfs:label>
    </owl:Class>

    <!-- Marathon Class -->
    <owl:Class rdf:about="http://example.org/ontology#Marathon">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology#SportingEvent"/>
        <rdfs:label xml:lang="en">Marathon</rdfs:label>
    </owl:Class>

    <!-- TheaterPlay Class -->
    <owl:Class rdf:about="http://example.org/ontology#TheaterPlay">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology#CulturalEvent"/>
        <rdfs:label xml:lang="en">TheaterPlay</rdfs:label>
    </owl:Class>

    <!-- CommunityEvent Class -->
    <owl:Class rdf:about="http://example.org/ontology#CommunityEvent">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology#Event"/>
        <rdfs:label xml:lang="en">CommunityEvent</rdfs:label>
    </owl:Class>

    <!-- SportingEvent Class -->
    <owl:Class rdf:about="http://example.org/ontology#SportingEvent">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology#Event"/>
        <rdfs:label xml:lang="en">SportingEvent</rdfs:label>
    </owl:Class>

    <!-- Fundraising Class -->
    <owl:Class rdf:about="http://example.org/ontology#Fundraising">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology#CommunityEvent"/>
        <rdfs:label xml:lang="en">Fundraising</rdfs:label>
    </owl:Class>

    <!-- CulturalEvent Class -->
    <owl:Class rdf:about="http://example.org/ontology#CulturalEvent">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology#Event"/>
        <rdfs:label xml:lang="en">CulturalEvent</rdfs:label>
    </owl:Class>

    <!-- VolunteerEvent Class -->
    <owl:Class rdf:about="http://example.org/ontology#VolunteerEvent">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology#CommunityEvent"/>
        <rdfs:label xml:lang="en">VolunteerEvent</rdfs:label>
    </owl:Class>

    <!-- Concert Class -->
    <owl:Class rdf:about="http://example.org/ontology#Concert">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology#CulturalEvent"/>
        <rdfs:label xml:lang="en">Concert</rdfs:label>
    </owl:Class>    


    <!-- Part Class -->

    <owl:Class rdf:about="http://example.org/ontology#Part">
        <rdfs:subClassOf rdf:resource="http://example.org/ontology#EnterteinmentEvent"/>
        <rdfs:label xml:lang="en-gb">Party</rdfs:label>
    </owl:Class>
    
</rdf:RDF>

    <!-- Workshop Class -->

   
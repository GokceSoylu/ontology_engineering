        <ontology:hasOrganizer rdf:resource="http://example.org/ontology/CodeConvene"/>
        <ontology:hasParticipant rdf:resource="http://example.org/ontology/Jane_Smith"/>
        <ontology:hasParticipant rdf:resource="http://example.org/ontology/John_Doe"/>
        <ontology:hasTime rdf:resource="http://example.org/ontology/AI_Time"/>
        <ontology:eventType xml:lang="en">Conferance</ontology:eventType>
